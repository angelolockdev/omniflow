{
  "manifest_version": 3,
  "name": "OmniFlow",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Autonomous client-side region adaptation engine for Google Flow.",
  "homepage_url": "https://angelolockdev.github.io/omniflow/",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://omniflow-admin.vercel.app/*"
  ],
  "background": {
    "service_worker": "app.js"
  },
  "action": {
    "default_title": "OmniFlow",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "stat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine.js"
      ],
      "matches": [
        "https://flow.google.com/*"
      ]
    }
  ]
}
